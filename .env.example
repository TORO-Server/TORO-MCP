# 秘密の値はありません。AUTH_INTERNAL_URL だけは必須で (既定値なし。未設定なら起動時にエラーで止まる)、ほかは任意で、既定は本番の値です。
# 認可とトークンの確認は auth、Wiki と稼働状態のデータは api に任せます。

# 必須。トークンの確認を頼む先 (認証サービスの内部の窓口。公開しない)
AUTH_INTERNAL_URL=http://auth.internal.example:8081
# 任意 (秘密)。auth の INTROSPECT_SECRET と同じ値。auth が共有秘密を求めるときに、確認 (/introspect) へ X-Toro-Token として付ける
# AUTH_INTROSPECT_SECRET=
# Wiki と稼働状態のデータを頼む先 (api)
# API_INTERNAL_URL=http://toro-api:8080

# 利用者に見せる URL
# PUBLIC_AUTH_URL=https://auth.torosaba.net
# PUBLIC_API_URL=https://api.torosaba.net
# PUBLIC_MCP_URL=https://mcp.torosaba.net
# PUBLIC_WIKI_URL=https://wiki.torosaba.net
# Cookie 付きで呼べる Origin (カンマ区切り)
# CORS_ORIGINS=https://wiki.torosaba.net
# PORT=8080

# 荒らし対策のコネクタ (crime-buster の connector。内部のネットワークだけ)。指定すると、管理用のツール (crime_buster_* と discord_*) が、
# いまの Discord のロールが ADMIN_ROLE_IDS の人にだけ見える。利用者のトークンをそのままコネクタに渡す (共有の秘密は無い)。空なら、出さない
# CRIMEBUSTER_CONNECTOR_URL=http://crime-buster:8090
# ADMIN_ROLE_IDS=<Discord のロール ID をカンマで区切る。未設定か空なら、管理用のツールは誰にも出さない>
