# 秘密の値はありません。すべて任意で、既定は本番の値です。
# 認可とトークンの確認は auth、Wiki と稼働状態のデータは api に任せます。

# トークンの確認を頼む先 (auth の内部の窓口。公開しない)
# AUTH_INTERNAL_URL=http://toro-auth:8081
# Wiki と稼働状態のデータを頼む先 (api)
# API_INTERNAL_URL=http://toro-api:8080

# 利用者に見せる URL
# PUBLIC_AUTH_URL=https://auth.torosaba.net
# PUBLIC_API_URL=https://api.torosaba.net
# PUBLIC_MCP_URL=https://mcp.torosaba.net
# PUBLIC_WIKI_URL=https://wiki.torosaba.net
# Cookie 付きで呼べる Origin (カンマ区切り)
# CORS_ORIGINS=https://wiki.torosaba.net
# PORT=8080

# 荒らし対策の窓口 (toro-guard の control。内部のネットワークだけ)。指定すると、管理用のツール (guard_* と discord_*) が、
# いまの Discord のロールが ADMIN_ROLE_IDS の人にだけ見える。利用者のトークンをそのまま窓口に渡す (共有の秘密は無い)。空なら、出さない
# GUARD_CONTROL_URL=http://toro-guard:8090
# ADMIN_ROLE_IDS=338718477332512769,497387545928138762
